<!DOCTYPE html>
<html>
<head>
  <title>Properties by Type</title>
  <style>
    body { font-family: sans-serif; background: #f4f4f4; margin: 0; padding: 20px; }
    .filter { margin-bottom: 20px; }
    .filter select { padding: 6px 10px; font-size: 14px; }

    .grid { display: flex; flex-wrap: wrap; justify-content: flex-start; }

    /* Card */
    .card {
      position: relative;
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      margin: 10px;
      padding: 15px;
      width: 300px;
      cursor: pointer;
      transition: transform 0.2s;
      overflow: hidden;
    }
    .card:hover { transform: scale(1.03); }
    .card img { width: 100%; height: 200px; object-fit: cover; border-radius: 6px; }

    /* Badges */
    .badge { position: absolute; top: 12px; left: 12px; background: #0077cc; color: #fff; padding: 5px 10px; font-size: 12px; font-weight: bold; border-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
    .badge.sale { background: #28a745; }
    .badge.sold { background: #dc3545; }
    .badge.new  { background: #ff9800; }
    .badge.open { background: #17a2b8; }
    .price-badge { position: absolute; top: 12px; right: 12px; background: #333; color: #fff; padding: 5px 12px; font-size: 14px; font-weight: bold; border-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
    .type-badge { position: absolute; top: 45px; left: 12px; background: #6c757d; color: #fff; padding: 4px 10px; font-size: 11px; font-weight: bold; border-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.15); }

    /* Pagination */
    .pagination { margin: 20px 0; text-align: center; }
    .pagination a { margin: 0 5px; padding: 8px 12px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #0077cc; }
    .pagination a.active { background: #0077cc; color: #fff; }
    .pagination a:hover { background: #005fa3; color: #fff; }
  </style>
</head>
<body>
  <h1>Property Listings - <%= cities.join(", ") %></h1>

  <!-- Filter Dropdown -->
  <div class="filter">
    <form method="get" action="/properties/type">
      <input type="hidden" name="page" value="1">
      <label>Filter by Type:</label>
      <select name="type" onchange="this.form.submit()">
        <option value="">All Types</option>
        <% propertyTypes.forEach(type => { %>
          <option value="<%= type %>" <%= selectedType === type ? 'selected' : '' %>><%= type %></option>
        <% }) %>
      </select>
    </form>
  </div>

  <div class="grid">
    <% properties.forEach(p => { %>
      <div class="card" onclick="window.location.href='/property/<%= p.ListingKey %>'">
        <!-- Status Badge -->
        <% if (p.StandardStatus === "Active") { %>
          <div class="badge sale">For Sale</div>
        <% } else if (p.StandardStatus === "Sold") { %>
          <div class="badge sold">Sold</div>
        <% } else if (p.StandardStatus === "New") { %>
          <div class="badge new">New</div>
        <% } else if (p.OpenHouse && p.OpenHouse.length > 0) { %>
          <div class="badge open">Open House</div>
        <% } %>

        <!-- Type Badge -->
        <div class="type-badge"><%= p.PropertySubType || "Unknown Type" %></div>

        <!-- Price Badge -->
        <div class="price-badge">$<%= (p.ListPrice != null) ? p.ListPrice.toLocaleString() : "N/A" %></div>

        <!-- Image -->
        <% if (p.Media && p.Media.length > 0 && p.Media[0].MediaURL) { %>
          <img src="<%= p.Media[0].MediaURL %>" alt="Property Image">
        <% } else { %>
          <img src="https://via.placeholder.com/300x200?text=No+Image" alt="No Image">
        <% } %>

        <h3><%= p.UnparsedAddress || "No Address" %></h3>
        <p>Status: <%= p.StandardStatus || "N/A" %></p>
        <p>City: <%= p.City || "N/A" %>, Province: <%= p.StateOrProvince || "N/A" %></p>
      </div>
    <% }) %>
  </div>

  <!-- Pagination -->
  <div class="pagination">
    <% if (currentPage > 1) { %>
      <a href="/properties/type?page=<%= currentPage - 1 %>&type=<%= selectedType %>">Previous</a>
    <% } %>

    <a class="active"><%= currentPage %></a>

    <% if (hasMore) { %>
      <a href="/properties/type?page=<%= currentPage + 1 %>&type=<%= selectedType %>">Next</a>
    <% } %>
  </div>
</body>
</html>
